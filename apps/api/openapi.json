{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "O banco respondeu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "O banco não respondeu dentro do prazo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "summary": "O estado da api e do banco. Rota pública.",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "SessionsController_create",
        "parameters": [
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "description": "O endereço do navegador, que a web repassa. A api conta as tentativas por ele (regra 6.1); sem o cabeçalho, vale o endereço da conexão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "description": "O User-Agent do navegador, que a web repassa, guardado na sessão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "O login abriu a sessão. O token só é devolvido aqui.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionToken"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o e-mail ou a senha faltam, não são texto ou passam do tamanho máximo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_CREDENTIALS`: o e-mail ou a senha não conferem, ou o usuário está desativado ou sem senha. A mensagem é a mesma em todos os casos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "`TOO_MANY_ATTEMPTS`: tentativas demais do e-mail ou da origem (regra 6.1). A mensagem não diz se o e-mail existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Entra com e-mail e senha e abre uma sessão. Rota pública.",
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "operationId": "SessionsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "As sessões ativas do usuário da sessão corrente, e só dele: a corrente primeiro, depois as outras do último uso mais recente ao mais antigo. Sem paginação: a lista é curta, porque uma sessão vence em até 30 dias (LLD, seção 5, \"Listas\").",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "As sessões ativas do usuário.",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/current": {
      "get": {
        "operationId": "SessionsController_current",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A sessão vale. O uso renova o prazo de inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "A sessão corrente e o usuário dela.",
        "tags": [
          "sessions"
        ]
      },
      "delete": {
        "operationId": "SessionsController_endCurrent",
        "parameters": [],
        "responses": {
          "204": {
            "description": "A sessão corrente foi encerrada: o token dela não vale mais."
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Sai: encerra a sessão corrente.",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{id}": {
      "delete": {
        "operationId": "SessionsController_end",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "O id da sessão, como a lista de sessões o devolve.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "A sessão foi encerrada na hora: o token dela não vale mais."
          },
          "400": {
            "description": "`INVALID_INPUT`: o id não é um UUID (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: a sessão não existe, é de outro usuário ou já não está ativa. A resposta é a mesma nos três casos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Encerra uma sessão ativa do próprio usuário.",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/recovery-links/{token}": {
      "get": {
        "operationId": "RecoveryLinksController_find",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "O token do link de recuperação, como está no link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "description": "O endereço do navegador, que a web repassa. A api conta as tentativas por ele (regra 6.1); sem o cabeçalho, vale o endereço da conexão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "O link vale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryLink"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: o link não existe, já foi usado ou venceu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "`TOO_MANY_ATTEMPTS`: tentativas demais da origem (regra 6.1).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Confere um link de recuperação antes de pedir a senha. Rota pública.",
        "tags": [
          "recovery-links"
        ]
      }
    },
    "/v1/recovery-links/{token}/use": {
      "post": {
        "operationId": "RecoveryLinksController_use",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "O token do link de recuperação, como está no link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "description": "O endereço do navegador, que a web repassa. A api conta as tentativas por ele (regra 6.1); sem o cabeçalho, vale o endereço da conexão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "description": "O User-Agent do navegador, que a web repassa, guardado na sessão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPassword"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A senha foi definida, as outras sessões do usuário foram encerradas e uma sessão nova foi aberta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionToken"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: a senha tem menos de 12 ou mais de 256 caracteres, ou a confirmação é diferente (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: o link não existe, já foi usado ou venceu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "`TOO_MANY_ATTEMPTS`: tentativas demais da origem (regra 6.1).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Usa um link de recuperação: define a senha e entra. Rota pública.",
        "tags": [
          "recovery-links"
        ]
      }
    },
    "/v1/users/me/password": {
      "put": {
        "operationId": "UsersController_changePassword",
        "parameters": [
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "description": "O endereço do navegador, que a web repassa. A api conta as tentativas por ele (regra 6.1); sem o cabeçalho, vale o endereço da conexão.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "A senha foi trocada e as outras sessões do usuário foram encerradas. A sessão corrente continua aberta."
          },
          "400": {
            "description": "`INVALID_INPUT`: a senha atual falta, a nova tem menos de 12 ou mais de 256 caracteres, ou a confirmação é diferente (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "`INVALID_CURRENT_PASSWORD`: a senha atual não confere. A falha conta no limite de tentativas do e-mail e da origem (regra 6.1).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "`TOO_MANY_ATTEMPTS`: falhas demais da senha do e-mail ou da origem (regra 6.1).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Troca a senha do usuário da sessão corrente.",
        "tags": [
          "users"
        ]
      }
    },
    "/v1/entities": {
      "get": {
        "operationId": "EntitiesController_list",
        "parameters": [
          {
            "name": "active",
            "required": false,
            "in": "query",
            "description": "`true` traz só as entidades ativas, as que aparecem nas escolhas; `false`, só as desativadas. Sem o parâmetro, traz todas.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Todas as entidades do filtro, numa lista inteira, sem `cursor` (LLD, seção 5): as ativas primeiro, e cada grupo pelo nome, em ordem alfabética.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Entity"
                  }
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o `active` não é `true` nem `false` (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lista as entidades.",
        "tags": [
          "entities"
        ]
      },
      "post": {
        "operationId": "EntitiesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEntity"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A entidade foi criada, ativa, na versão 1, com as operações pedidas ligadas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o tipo falta ou não é conhecido, o nome falta, é vazio ou passa de 120 caracteres, o documento não é um CPF (pessoa física) ou um CNPJ (pessoa jurídica) com os dígitos verificadores certos, ou uma operação não é conhecida ou se repete (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "`DUPLICATE_TAX_ID`: o documento já é de outra entidade, ativa ou desativada. `OPERATION_REQUIRES_COMPANY`: a pessoa física veio com uma operação (regra 6.2).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Cadastra uma entidade.",
        "tags": [
          "entities"
        ]
      }
    },
    "/v1/entities/{id}": {
      "get": {
        "operationId": "EntitiesController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "O id da entidade.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A entidade, ativa ou desativada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o id não é um UUID (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: a entidade não existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lê uma entidade.",
        "tags": [
          "entities"
        ]
      },
      "put": {
        "operationId": "EntitiesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "O id da entidade.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityEdit"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A entidade com os dados novos e a versão seguinte. As operações não mudam por esta rota.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o id não é um UUID, a versão falta, o tipo falta ou não é conhecido, o nome falta, é vazio ou passa de 120 caracteres, ou o documento não é um CPF ou um CNPJ válido para o tipo (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: a entidade não existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "`VERSION_CONFLICT`: a `version` enviada não é a atual: a entidade mudou desde a leitura (regra 6.20).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "`ENTITY_TYPE_IMMUTABLE`: o tipo enviado não é o da entidade, que não muda depois da criação (regra 6.2). `DUPLICATE_TAX_ID`: o documento já é de outra entidade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Edita o nome e o documento de uma entidade.",
        "tags": [
          "entities"
        ]
      }
    },
    "/v1/entities/{id}/active": {
      "put": {
        "operationId": "EntitiesController_setActive",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "O id da entidade.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityActivation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A entidade desativada ou reativada, com a versão seguinte. Pedir o estado que ela já tem responde 200 sem mudar a versão. Desativar não desliga as operações nem apaga nada (regra 6.2).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_INPUT`: o id não é um UUID, ou o `active` ou a versão faltam (em `fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: sem sessão, ou com a sessão encerrada, vencida pelo prazo máximo ou por inatividade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: a entidade não existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "`VERSION_CONFLICT`: a `version` enviada não é a atual: a entidade mudou desde a leitura (regra 6.20).",
            "content": {
              "application/json": {
