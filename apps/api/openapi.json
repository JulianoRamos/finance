  "info": {
    "title": "finance",
    "description": "A api do finance. O contrato das rotas: LLD, seção 5.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "description": "O token da sessão, que a web lê do cookie e manda em Authorization: Bearer (LLD, seção 5).",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DatabaseState": {
        "type": "string",
        "enum": [
          "connected",
          "down"
        ],
        "description": "Se o banco respondeu a uma consulta dentro do prazo."
      },
      "Health": {
        "type": "object",
        "properties": {
          "database": {
            "description": "Se o banco respondeu a uma consulta dentro do prazo.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DatabaseState"
              }
            ]
          }
        },
        "required": [
          "database"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "O e-mail do usuário. Comparado sem distinguir maiúsculas.",
            "example": "ana@exemplo.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "description": "A senha.",
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "O token opaco da sessão, que a web guarda no cookie httpOnly. Não é devolvido de novo."
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "O prazo máximo da sessão (o login mais SESSION_MAX_DAYS)."
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "O código estável do erro, em UPPER_SNAKE_CASE, que o cliente confere.",
            "example": "INVALID_INPUT"
          },
          "message": {
            "type": "string",
            "description": "O texto para o usuário, em português. Pode mudar."
          },
          "fields": {
            "type": "object",
            "description": "Na entrada inválida: o motivo de cada campo recusado.",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "managesAccess": {
            "type": "boolean",
            "description": "Se gere usuários e acessos (regra 6.1)."
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "managesAccess"
        ]
      },
      "CurrentSession": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "O prazo máximo da sessão."
          }
        },
        "required": [
          "user",
          "expiresAt"
        ]
      },
      "SessionSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "browser": {
            "type": "string",
            "nullable": true,
            "description": "O navegador, lido do User-Agent do login, como \"Chrome\" ou \"Safari\". Nulo quando o User-Agent não veio ou não é de um navegador conhecido.",
            "example": "Chrome"
          },
          "platform": {
            "type": "string",
            "nullable": true,
            "description": "O sistema ou o aparelho, lido do User-Agent do login, como \"macOS\", \"Windows\" ou \"iPhone\". Nulo quando não é reconhecido.",
            "example": "macOS"
          },
          "origin": {
            "type": "string",
            "description": "O endereço de origem do login (regra 6.1).",
            "example": "192.0.2.10"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "O instante do login."
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string",
            "description": "O último uso, gravado no máximo uma vez por minuto."
          },
          "current": {
            "type": "boolean",
            "description": "Se é a sessão do token que fez o pedido."
          }
        },
        "required": [
          "id",
          "browser",
          "platform",
          "origin",
          "createdAt",
          "lastUsedAt",
          "current"
        ]
      },
      "RecoveryLink": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "O e-mail do usuário que vai definir a senha."
          }
        },
        "required": [
          "email"
        ]
      },
      "SetPassword": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "A senha nova.",
            "minLength": 12,
            "maxLength": 256
          },
          "passwordConfirmation": {
            "type": "string",
            "description": "A senha nova, repetida (regra 6.1)."
          }
        },
        "required": [
          "password",
          "passwordConfirmation"
        ]
      },
      "ChangePassword": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "A senha atual.",
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "description": "A senha nova.",
            "minLength": 12,
            "maxLength": 256
          },
          "passwordConfirmation": {
            "type": "string",
            "description": "A senha nova, repetida (regra 6.1)."
          }
        },
        "required": [
          "currentPassword",
          "password",
          "passwordConfirmation"
        ]
      },
      "Entity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "individual",
              "company"
            ],
            "description": "Pessoa física (`individual`) ou jurídica (`company`). Não muda depois da criação (regra 6.2)."
          },
          "name": {
            "type": "string",
            "description": "O nome da entidade.",
            "example": "Clínica Exemplo"
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "description": "O CPF ou o CNPJ, só com os caracteres, sem a pontuação. Nulo quando a entidade não tem documento. A web o formata, e mascara o CPF nas listas.",
            "example": "00000000000191"
          },
          "active": {
            "type": "boolean",
            "description": "Falso na entidade desativada, que some das escolhas e continua nos registros (regra 6.2)."
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "clinic"
              ]
            },
            "description": "As operações ligadas, em ordem alfabética. Sempre vazia na pessoa física (regra 6.2).",
            "example": [
              "clinic"
            ]
          },
          "version": {
            "type": "integer",
            "description": "A versão, que a edição e a desativação mandam de volta (regra 6.20).",
            "example": 1
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "taxId",
          "active",
          "operations",
          "version"
        ]
      },
      "NewEntity": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "individual",
              "company"
            ],
            "description": "Pessoa física (`individual`) ou jurídica (`company`). Não muda depois da criação (regra 6.2)."
          },
          "name": {
            "type": "string",
            "description": "O nome, como o usuário quer vê-lo. A api tira os espaços das pontas.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Clínica Exemplo"
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "description": "O CPF (pessoa física) ou o CNPJ (pessoa jurídica, também o alfanumérico), com ou sem a pontuação. Opcional: nulo ou vazio fica sem documento. A api confere os dígitos verificadores e o guarda só com os caracteres, com as letras em maiúsculas. Único entre todas as entidades.",
            "example": "00.000.000/0001-91"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "clinic"
              ]
            },
            "uniqueItems": true,
            "description": "As operações a ligar na criação. Opcional, e só na pessoa jurídica (regra 6.2)."
          }
        },
        "required": [
          "type",
          "name"
        ]
      },
      "EntityEdit": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "A versão lida (regra 6.20)."
          },
          "type": {
            "type": "string",
            "enum": [
              "individual",
              "company"
            ],
            "description": "O tipo da entidade, que tem de ser o atual: a api recusa a mudança com 422 `ENTITY_TYPE_IMMUTABLE` (regra 6.2)."
          },
          "name": {
            "type": "string",
            "description": "O nome, como o usuário quer vê-lo. A api tira os espaços das pontas.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Clínica Exemplo"
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "description": "O CPF (pessoa física) ou o CNPJ (pessoa jurídica, também o alfanumérico), com ou sem a pontuação. Opcional: nulo ou vazio fica sem documento. A api confere os dígitos verificadores e o guarda só com os caracteres, com as letras em maiúsculas. Único entre todas as entidades.",
            "example": "00.000.000/0001-91"
          }
        },
        "required": [
          "version",
          "type",
          "name"
        ]
      },
      "EntityActivation": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "A versão lida (regra 6.20)."
          },
          "active": {
            "type": "boolean",
            "description": "Falso desativa a entidade; verdadeiro a reativa."
          }
        },
        "required": [
          "version",
          "active"
        ]
      }
    }
  }
}
