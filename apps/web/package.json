{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../api/openapi.json --output src/api/schema.d.ts",
    "dev": "pnpm api:generate && next dev --hostname 0.0.0.0 --port 3000",
    "build": "pnpm api:generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "pnpm api:generate && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "geist": "1.9.2",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
